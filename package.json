{
  "name": "gariton-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vinext dev --port 3000",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "eslint .",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "cf:typegen": "wrangler types cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply gariton-site --local",
    "db:migrate:remote": "wrangler d1 migrations apply gariton-site --remote",
    "migrate:cloudflare": "node scripts/migrate-data.mjs"
  },
  "dependencies": {
    "@mantine/core": "^9.1.0",
    "@mantine/hooks": "^9.1.0",
    "@tabler/icons-react": "^3.41.1",
    "@vinext/cloudflare": "^1.0.0-beta.8",
    "next": "^16.3.0",
    "nodemailer": "^9.0.3",
    "postcss": "^8.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.0-beta.10"
  },
  "overrides": {
    "postcss": "^8.5.26"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@rolldown/binding-linux-x64-gnu": "^1.2.9",
    "@types/node": "22.15.29",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "9.28.0",
    "eslint-config-next": "^16.3.0",
    "lightningcss-linux-x64-gnu": "^1.33.0",
    "typescript": "5.8.3",
    "vite": "^8.3.0",
    "wrangler": "^4.135.0"
  },
  "type": "module"
}
